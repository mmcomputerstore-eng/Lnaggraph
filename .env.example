# Groq API Key (required for ChatGroq models)
GROQ_API_KEY="your_groq_api_key_here"

# Tavily API Key (required for langchain-tavily web search)
TAVILY_API_KEY="your_tavily_api_key_here"

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# LangSmith Tracing & Observability (optional, recommended for LangGraph debugging)
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="your_langsmith_api_key_here"
# LANGCHAIN_PROJECT="langgraph-demo"

# Optional: Other LLM Providers
# OPENAI_API_KEY="your_openai_api_key_here"
